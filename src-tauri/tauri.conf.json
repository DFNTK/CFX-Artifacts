{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CFX Artifacts",
  "version": "1.0.0",
  "identifier": "net.cfxartifacts.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "CFX Artifacts", "width": 760, "height": 760, "minWidth": 600, "minHeight": 600, "resizable": true, "visible": false, "center": true },
      { "label": "splash", "title": "CFX Artifacts", "url": "splash.html", "width": 520, "height": 520, "resizable": false, "decorations": false, "center": true, "alwaysOnTop": true, "skipTaskbar": false }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png","icons/128x128.png","icons/icon.ico"] }
}

